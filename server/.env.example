# GlowCart Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or local fallback)
# Replace with your MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/GlowCartDB?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/GlowCartDB?retryWrites=true&w=majority

# Authentication Secret
JWT_SECRET=glowcart_super_secret_jwt_key_2026_beauty_ecommerce
JWT_EXPIRE=7d

# Application Client URL (CORS)
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Optional Image Storage Abstraction (Cloudinary / S3)
IMAGE_STORAGE_PROVIDER=local
IMAGE_STORAGE_KEY=your_image_storage_key
IMAGE_STORAGE_SECRET=your_image_storage_secret

# Optional Payment Gateway Provider (Razorpay / Stripe Sandbox)
PAYMENT_PROVIDER_KEY=rzp_test_placeholder_key
PAYMENT_PROVIDER_SECRET=rzp_test_placeholder_secret
